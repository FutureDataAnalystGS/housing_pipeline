 "items": {
  "relevant": true,
  "actions": [
   {
    "instrument": "I20",
    "description": "Przekwalifikowanie lokali położonych w suterenach i innych pomieszczeń nie odpowiadających wymogom technicznym na lokale użytkowe, gospodarcze lub pomieszczenia tymczasowe.",
    "status": "planned",
    "evidence": {
     "quote": "Lokale położone w suterenach i inne pomieszczenia nie odpowiadające wymogom technicznym, jakim powinny odpowiadać budynki i ich usytuowanie z przeznaczeniem na stały pobyt ludzi zostaną przekwalifikowane w zależności od potrzeb na lokale użytkowe, gospodarcze lub pomieszczenia tymczasowe."
    }
   },
   {
    "instrument": "I21",
    "description": "Likwidacja niesamodzielnych lokali mieszkalnych poprzez scalanie ich do uzyskania lokali w pełni samodzielnych.",
    "status": "planned",
    "evidence": {
     "quote": "Zakłada się kontynuowanie działań zmierzających do stopniowego likwidowania niesamodzielnych lokali mieszkalnych poprzez scalanie ich w celu uzyskania lokali w pełni samodzielnych."
    }
   },
   {
    "instrument": "I22",
    "description": "Przystosowanie lokali mieszkalnych wymagających remontu do potrzeb osób z niepełnosprawnościami.",
    "status": "planned",
    "evidence": {
     "quote": "Lokale mieszkalne wymagające remontu, których położenie i układ pomieszczeń umożliwiają dostęp osobom na wózkach inwalidzkich, będą przystosowywane do potrzeb osób z niepełnosprawnościami."
    }
   },
   {
    "instrument": "I23",
    "description": "Finansowanie konserwatorskich, restauratorskich lub budowlanych prac przy zabytkach wpisanym do rejestru zabytków oraz budynkach i zabytkach niewpisanych do rejestru.",
    "status": "planned",
    "evidence": {
     "quote": "Gmina Miasta Gdyni planuje w latach 2022- 2026 kontynuację udzielania dotacji celowych na dofinansowanie prac konserwatorskich, restauratorskich lub robót budowlanych przy zabytku wpisanym do rejestru zabytków, który jest własnością Gminy, zabytków niestanowiących wyłącznej własności Gminy oraz budynków oraz zabytków niewpisanych do rejestru."
    }
   },
   {
    "instrument": "I24",
    "description": "Rewitalizacja miasta Gdyni w oparciu o Gminny Program Rewitalizacji miasta Gdyni na lata 2017-2026.",
    "status": "planned",
    "evidence": {
     "quote": "Gmina Miasta Gdynia prowadzi proces rewitalizacji w oparciu o Gminny Program Rewitalizacji miasta Gdyni na lata 2017-2026, który obejmuje m.in. działania zmierzające do podniesienia jakości zamieszkiwania na obszarze objętym oddziaływaniem programu."
    }
   },
   {
    "instrument": "I25",
    "description": "Realizacja kolejnych inwestycji mieszkaniowych.",
    "status": "planned",
    "evidence": {
     "quote": "Gmina będzie podejmować działania na rzecz realizacji kolejnych inwestycji mieszkaniowych."
    }
   },
   {
    "instrument": "I26",
    "description": "Tworzenie większej liczby mieszkań chronionych, wspieranych i treningowych.",
    "status": "planned",
    "evidence": {
     "quote": "Gmina będzie dążyć do utworzenia większej liczby mieszkań chronionych, wspieranych i treningowych."
    }
   },
   {
    "instrument": "I27",
    "description": "Wykorzystanie opróżnionych lokalów w budynkach oświatowych na potrzeby działalności statutowej szkoły lub innych celów.",
    "status": "planned",
    "evidence": {
     "quote": "Opróżnione lokale w budynkach oświatowych będą wykorzystywane na potrzeby działalności statutowej szkoły, w której użytkowaniu znajdują się te lokale lub inne cele związane z zaspakajaniem potrzeb wspólnoty samorządowej."
    }
   },
   {
    "instrument": "I28",
    "description": "Prowadzenie działań na rzecz prawidłowego funkcjonowania osób i rodzin trafiających do zasobu komunalnego w ramach realizacji wyroków eksmisyjnych.",
    "status": "planned",
    "evidence": {
     "quote": "Prowadzone będą działania mające na celu prawidłowe funkcjonowanie osób i rodzin trafiających do zasobu komunalnego w ramach realizacji wyroków eksmisyjnych, polegające na bieżącym monitorowaniu płatności, zaś w przypadku zaległości podejmowaniu działań zmierzających do podniesienia kompetencji najemców, m.in. prowadzenie treningu budżetowego."
    }
   },
   {
    "instrument": "I29",
    "description": "Realizacja wyroków eksmisyjnych dla osób, wobec których nie orzeczono uprawnienia do wskazania najmu socjalnego lokalu.",
    "status": "planned",
    "evidence": {
     "quote": "Gmina będzie podejmować starania na rzecz szybkiej realizacji wyroków eksmisyjnych skierowanych do osób, wobec których nie orzeczono uprawnienia do wskazania najmu socjalnego lokalu poprzez wskazywanie pomieszczeń tymczasowych zapewnianych na okres do 6 miesięcy."
    }
   },
   {
    "instrument": "I21",
    "description": "Zabezpieczenie na dłuższy czas schronienia osobom, którym nie przysługuje prawo do lokalu z mieszkaniowego zasobu Gminy.",
    "status": "planned",
    "evidence": {
     "quote": "W przypadku konieczności zabezpieczenia na dłuższy czas schronienia osobom, którym nie przysługuje prawo do lokalu z mieszkaniowego zasobu Gminy za pośrednictwem Miejskiego Ośrodka Pomocy Społecznej realizowane będą programy wsparcia polegające na wynajęciu lokalu na wolnym rynku z długofalowym dofinansowaniem z budżetu miasta."
    }
   },
   {
    "instrument": "I22",
    "description": "Przekazanie wspólnotom mieszkaniowym części terenów zewnętrznych.",
    "status": "planned",
    "evidence": {
     "quote": "Wskazuje się potrzebę podjęcia działań w zakresie przekazywania wspólnotom mieszkaniowym terenów przyległych, bez możliwości ich grodzenia, w celu porządkowania stanu formalno-prawnego w zakresie korzystania przez właścicieli nieruchomości z terenów Gminy Miasta Gdyni, a w szczególności podziału kompetencji i obowiązków dotyczących zagospodarowania tych terenów, utrzymania ich stanu technicznego i estetycznego oraz sanitarnego."
    }
   }
  ]
 },
